{
  "rules": {
    "roomMeta": {
      ".read": true,
      "$roomId": {
        ".write": true,
        ".validate": "newData.hasChildren(['title','createdBy','createdAt','playerCount']) && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 30 && newData.child('createdBy').isString() && (newData.child('createdBy').val() === 'system' || root.child('memberProfiles').child(newData.child('createdBy').val()).exists()) && newData.child('createdAt').isNumber() && newData.child('playerCount').isNumber() && newData.child('playerCount').val() >= 0"
      }
    },
    "roomBoards": {
      ".read": true,
      "$roomId": {
        ".write": true
      }
    },
    "roomPresence": {
      ".read": true,
      "$roomId": {
        "$clientId": {
          ".write": true
        }
      }
    },
    "playerFruit": {
      ".read": true,
      ".write": true
    },
    "playerLastSeen": {
      ".read": true,
      ".write": true
    },
    "fruitCounter": {
      ".read": true,
      ".write": true
    },
    "memberProfiles": {
      ".read": true,
      ".write": false
    },
    "memberFonts": {
      ".read": true,
      "$uid": {
        ".write": true,
        ".validate": "newData.isString() && (newData.val() === 'default' || (root.child('fontShopScores').child(newData.val()).exists() && root.child('memberTotalScore').child($uid).val() >= root.child('fontShopScores').child(newData.val()).val()))"
      }
    },
    "fontShopScores": {
      ".read": true,
      ".write": false
    },
    "memberTotalScore": {
      ".read": true,
      ".write": true,
      "$uid": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      }
    },
    "members": {
      ".read": false,
      ".write": false
    },
    "pushTokens": {
      ".read": false,
      ".write": true,
      "$uid": {
        ".validate": "newData.hasChildren(['token', 'platform', 'ts']) && newData.child('token').isString()"
      }
    },
    "reports": {
      ".read": false,
      ".write": true,
      "$reportId": {
        ".validate": "newData.hasChildren(['reporterId', 'targetId', 'reason', 'ts']) && newData.child('reason').isString() && newData.child('reason').val().length <= 300"
      }
    },
    "memberNicknames": {
      ".read": false,
      ".write": false
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
